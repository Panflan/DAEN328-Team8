# .env file

# The City of New York 311 Service Requests API URL
API_ENDPOINT = "https://data.cityofnewyork.us/resource/erm2-nwe9.json"

# Where the raw extracted data will sit in the project
RAW_DATA = "data/imported_data.json"

# Config variables for primary postgres database running inside of the docker container
PSQL_HOST = "db"
PSQL_DB = "daen328-team8-service_request-data"
PSQL_USER = <Your Username> (Secret)
PSQL_PASSWORD = <Your Password> (Secret)
PSQL_PORT = "5432"

# Config variables for cdc logging postgres database running inside of the docker container
CDC_HOST = "cdc_db"
CDC_DB = "daen328-team8-cdc"
CDC_USER = <Your Username> (Secret)
CDC_PASSWORD = <Your Password> (Secret)
CDC_PORT = "5432"
