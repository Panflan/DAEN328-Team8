# EXAMPLE .env FILE

# NYC 311 Service Requests from 2020 to Present. No API key is required.
API_ENDPOINT="https://data.cityofnewyork.us/resource/erm2-nwe9.json"

# Raw API data is retained locally for debugging and is ignored by Git.
RAW_DATA="data/nyc_311_raw.jsonl"

# Initial run samples up to 50,000 records. Later runs use the saved checkpoint.
BATCH_SIZE="10000"
INITIAL_LOAD_LIMIT="50000"

# Postgres credentials

POSTGRES_HOST="db"

POSTGRES_DB="daen328_team8_nyc311"

POSTGRES_USER="postgres"

POSTGRES_PASSWORD="change_me"

POSTGRES_PORT="5432"
