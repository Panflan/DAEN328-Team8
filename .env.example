# EXAMPLE .env FILE

# The City of Chicago "Food Inspections" API endpoint URL
API_ENDPOINT = "https://data.cityofchicago.org/resource/4ijn-s7e5.json"

# Where the raw extracted data (in json format) will sit in the project
RAW_DATA = "data/imported_data.json"

# Postgres credentials
POSTGRES_HOST = "db" # Which docker container is hosting postgres

POSTGRES_DB = "daen328-team8-crime_data" # Database name

POSTGRES_USER = "..." # Username (Secret)

POSTGRES_PASSWORD = "..."  # Password (Secret)

POSTGRES_PORT = "5432" # Connection Port
